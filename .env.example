APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://objectif-terres.test

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SF_SUPPORT_REQUESTS_URL=
SF_SUPPORT_REQUESTS_URL_ADM=
SF_SUPPORT_PERSONAL_REQUESTS_URL=

# Salesforce REST API (Forrest) — OAuth 2.0 Client Credentials flow.
# Connected App must have "Enable Client Credentials Flow" enabled with a run-as user.
# SF_LOGIN_URL must be the org's My Domain URL (NOT login/test.salesforce.com).
SF_AUTHENTICATION=ClientCredentials
SF_CONSUMER_KEY=
SF_CONSUMER_SECRET=
SF_LOGIN_URL=

# API Documentation HTTP Basic Auth
# Set API_DOC_AUTH_ENABLED=false to disable Laravel auth (e.g., when nginx handles auth)
API_DOC_AUTH_ENABLED=true
API_DOC_USERNAME=api_admin
API_DOC_PASSWORD=

# Teamwork API (projet Objectif Terres 653749)
TEAMWORK_API_URL=https://ideagency.teamwork.com
TEAMWORK_API_TOKEN=
