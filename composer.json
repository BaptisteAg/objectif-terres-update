{
    "name": "kaffein/objectif-terres",
    "type": "project",
    "description": "Non profit Objectif Terres website",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "ext-fileinfo": "*",
        "ext-json": "*",
        "php": "^8.0",
        "aacotroneo/laravel-saml2": "^2.1",
        "chelout/laravel-relationship-events": "^1.5",
        "darkaonline/l5-swagger": "^7.0",
        "digital-creative/clickable-table-row": "^0.2.0",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "gluedev/laravel-stackdriver": "^0.2.2",
        "guzzlehttp/guzzle": "^6.3.1|^7.0.1",
        "intervention/image": "^2.7",
        "kabbouchi/nova-impersonate": "^1.3",
        "laravel/framework": "^7.29",
        "laravel/nova": "*",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^2.0",
        "laravelcollective/html": "^6.1",
        "maatwebsite/excel": "^3.1",
        "mccool/laravel-auto-presenter": "^7.4",
        "numaxlab/nova-ckeditor5-classic": "^1.1",
        "omniphx/forrest": "^2.7",
        "ozankurt/repoist": "^3.2",
        "predis/predis": "^1.1",
        "symfony/mailgun-mailer": "^6.0",
        "vedmant/laravel-feed-reader": "^1.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.2",
        "barryvdh/laravel-ide-helper": "^2.6",
        "facade/ignition": "^2.0",
        "fakerphp/faker": "^1.9.1",
        "krlove/eloquent-model-generator": "^1.3",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^4.3",
        "phpunit/phpunit": "^8.5.8|^9.3.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "./nova"
        }
    ]
}
