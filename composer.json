{
    "name": "kaffein/objectif-terres",
    "type": "project",
    "description": "Non profit Objectif Terres website",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "ext-fileinfo": "*",
        "ext-json": "*",
        "php": "^8.0",
        "aacotroneo/laravel-saml2": "^2.1",
        "chelout/laravel-relationship-events": "^1.5",
        "darkaonline/l5-swagger": "^8.0",
        "digital-creative/clickable-table-row": "^0.2.0",
        "guzzlehttp/guzzle": "^6.3.1|^7.0.1",
        "intervention/image": "^2.7",
        "kabbouchi/nova-impersonate": "^1.3",
        "laravel/framework": "^8.83",
        "laravel/nova": "^3.10",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^3.0",
        "laravelcollective/html": "^6.2",
        "maatwebsite/excel": "^3.1",
        "mccool/laravel-auto-presenter": "^7.5",
        "numaxlab/nova-ckeditor5-classic": "^1.1",
        "omniphx/forrest": "^2.9",
        "predis/predis": "^1.1",
        "symfony/mailgun-mailer": "^6.0",
        "vedmant/laravel-feed-reader": "^1.5"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.5",
        "barryvdh/laravel-ide-helper": "^2.8",
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "krlove/eloquent-model-generator": "^1.3",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^5.10",
        "phpunit/phpunit": "^9.5.10"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "policy": {
            "advisories": {
                "ignore": {
                    "laravel/framework": {
                        "constraint": "^8.0",
                        "on-audit": false,
                        "reason": "Montee de version transitoire, voir docs/montee-de-version.md"
                    },
                    "league/flysystem": {
                        "on-audit": false,
                        "reason": "Montee de version transitoire, voir docs/montee-de-version.md"
                    }
                }
            }
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ]
}
